{
  "name": "@inixiative/prisma-map",
  "version": "1.0.0",
  "description": "Extracts a complete model map (fields, relations, FK info) from a Prisma v7 generated client",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "author": "Aron Greenspan",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.0.0"
  }
}
